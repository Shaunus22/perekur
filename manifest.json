{
  "manifest_version": 3,
  "name": "Перекур",
  "version": "1.3",
  "description": "Позови коллег на перекур!",
  "icons": {
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "notifications"
  ],
  "host_permissions": [
    "http://*/*",
    "https://api.github.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["prikol/Shrek_prikol.webp", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}